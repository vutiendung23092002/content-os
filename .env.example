# Runtime database connection, preferably the Supabase pooled connection.
DATABASE_URL=postgresql://user:password@host:6543/database

# Direct Supabase connection used only by drizzle-kit migrations.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database

# Meta secrets are server-only. Never prefix them with NEXT_PUBLIC_.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=
FACEBOOK_USER_ACCESS_TOKEN=

# Generate this value with a cryptographically secure password generator.
TOKEN_ENCRYPTION_KEY=

# Optional break-glass/automation secret sent only via x-han-access-secret.
# Staff never receives or types this value. Never expose it via NEXT_PUBLIC_*.
APP_ACCESS_SECRET=

# Supabase Auth (Project Settings > API). The publishable key is safe for the browser;
# authorization is still enforced by Supabase sessions and the app_users allowlist.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for private image storage. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket used for draft images.
SUPABASE_STORAGE_BUCKET=post-assets
# Dedicated random secret (32+ chars) for the storage cleanup cron endpoint.
ASSET_CLEANUP_SECRET=
# Dedicated random secret (32+ chars) for read-only Facebook sync/reconciliation cron endpoints.
FACEBOOK_CRON_SECRET=
# Optional for the local Windows scheduler; defaults to NEXT_PUBLIC_SITE_URL.
FACEBOOK_CRON_BASE_URL=http://127.0.0.1:3000

# Public app origin used by OAuth redirects behind Cloudflare Tunnel.
NEXT_PUBLIC_SITE_URL=https://content.example.com

# This email becomes the protected Super Admin after its first Google login.
INITIAL_ADMIN_EMAIL=owner@example.com

# Optional until AI content work begins.
AI_PROVIDER_API_KEY=

