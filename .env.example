# Runtime database connection, preferably the Supabase pooled connection.
DATABASE_URL=postgresql://user:password@host:6543/database

# Direct Supabase connection used only by drizzle-kit migrations.
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/database

# Meta secrets are server-only. Never prefix them with NEXT_PUBLIC_.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=
FACEBOOK_USER_ACCESS_TOKEN=

# Generate with a cryptographically secure password generator before use.
TOKEN_ENCRYPTION_KEY=
APP_ACCESS_SECRET=

# Optional until AI content work begins.
AI_PROVIDER_API_KEY=

