{
  "name": "han-content-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/next/dist/bin/next build",
    "build:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/vitest/vitest.mjs run src/db/repositories/repositories.integration.test.ts src/db/repositories/cron-job-repository.integration.test.ts",
    "test:db:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/vitest/vitest.mjs run src/db/repositories/repositories.integration.test.ts src/db/repositories/cron-job-repository.integration.test.ts",
    "test:db:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node node_modules/vitest/vitest.mjs run src/db/repositories/repositories.integration.test.ts src/db/repositories/cron-job-repository.integration.test.ts",
    "test:watch": "vitest",
    "db:generate": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/drizzle-kit/bin.cjs generate",
    "db:ping": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/check-database-connections.mjs",
    "db:ping:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/check-database-connections.mjs",
    "db:ping:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/check-database-connections.mjs",
    "db:migrate": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/drizzle-kit/bin.cjs check",
    "db:check:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node node_modules/drizzle-kit/bin.cjs check",
    "db:check:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node node_modules/drizzle-kit/bin.cjs check",
    "db:verify": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/verify-database-schema.mjs",
    "db:verify:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/verify-database-schema.mjs",
    "db:verify:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/verify-database-schema.mjs",
    "storage:configure": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/configure-media-bucket.mjs",
    "storage:configure:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/configure-media-bucket.mjs",
    "storage:configure:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/configure-media-bucket.mjs",
    "storage:smoke": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/smoke-asset-storage.mjs",
    "storage:smoke:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/smoke-asset-storage.mjs",
    "storage:smoke:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/smoke-asset-storage.mjs",
    "assets:cleanup": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/run-asset-cleanup.mjs",
    "assets:cleanup:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/run-asset-cleanup.mjs",
    "assets:cleanup:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/run-asset-cleanup.mjs",
    "facebook:cron": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/run-facebook-cron.mjs",
    "facebook:cron:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/run-facebook-cron.mjs",
    "facebook:cron:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/run-facebook-cron.mjs",
    "facebook:list-pages": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/list-managed-pages.mjs",
    "facebook:list-pages:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/list-managed-pages.mjs",
    "facebook:list-pages:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/list-managed-pages.mjs",
    "facebook:capability-smoke": "node scripts/run-with-env.mjs .env.local --expect=production -- node --conditions=react-server --import tsx scripts/meta-capability-smoke.ts",
    "facebook:capability-smoke:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node --conditions=react-server --import tsx scripts/meta-capability-smoke.ts",
    "facebook:capability-smoke:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node --conditions=react-server --import tsx scripts/meta-capability-smoke.ts",
    "credentials:rotate-pages": "node scripts/run-with-env.mjs .env.local --expect=production -- node --conditions=react-server --import tsx scripts/rotate-page-credentials.ts",
    "credentials:rotate-pages:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node --conditions=react-server --import tsx scripts/rotate-page-credentials.ts",
    "credentials:rotate-pages:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node --conditions=react-server --import tsx scripts/rotate-page-credentials.ts",
    "staging:env-check": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/verify-staging-environment.mjs",
    "staging:access-smoke": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/staging-access-smoke.mjs",
    "staging:restore-verify": "node scripts/verify-restored-database.mjs",
    "release:secret-scan": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/verify-release-secrets.mjs",
    "release:secret-scan:prod": "node scripts/run-with-env.mjs .env.local --expect=production -- node scripts/verify-release-secrets.mjs",
    "release:secret-scan:staging": "node scripts/run-with-env.mjs .env.staging --expect=staging -- node scripts/verify-release-secrets.mjs",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "dependencies": {
    "@next/env": "16.3.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
